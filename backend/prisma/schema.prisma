generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model SystemConfig {
  id                         String           @id @default(uuid())
  isConfigured               Boolean          @default(false)
  modeSupervision            ModeSupervision?
  domaine                    String?
  platformName               String           @default("RendezVousApp")
  slogan                     String?
  description                String?
  logoUrl                    String?
  address                    String?
  phone                      String?
  email                      String?
  joursOuvrables             String[]         @default([])
  horairesGeneraux           String?
  conditions                 String?
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @updatedAt
  conditionsReservation      String?
  delaiMinAnnulationHeures   Int              @default(0)
  delaiMinModificationHeures Int              @default(48)
  heroImageUrl               String?
  maxChangementsRdv          Int              @default(1)
  localisationUrl            String?
}

model User {
  id                    String                   @id @default(uuid())
  email                 String                   @unique
  passwordHash          String
  role                  Role
  statutCompte          StatutCompte             @default(EN_ATTENTE)
  emailVerifie          Boolean                  @default(false)
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  lastLoginAt           DateTime?
  auditLogs             AuditLog[]
  emailTokens           EmailVerificationToken[]
  notificationsReceived Notification[]           @relation("NotificationRecipient")
  notificationsSent     Notification[]           @relation("NotificationSender")
  professionnel  Professionnel?
  receptionniste Receptionniste?

  @@index([role])
  @@index([statutCompte])
}

model Professionnel {
  id                    String                 @id @default(uuid())
  userId                String                 @unique
  nom                   String
  specialite            String?
  description           String?
  adresse               String?
  telephone             String?
  photoUrl              String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  affectations          Affectation[]
  champsPersonnalises   ChampPersonnalise[]
  disponibilites        Disponibilite[]
  indisponibilites      Indisponibilite[]
  NoteClient            NoteClient[]
  ParametresReservation ParametresReservation?
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  rendezVous            RendezVous[]
  services              Service[]

  @@index([nom])
}

model Receptionniste {
  id           String        @id @default(uuid())
  userId       String        @unique
  nom          String
  telephone    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  affectations Affectation[]
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Affectation {
  id                  String         @id @default(uuid())
  professionnelId     String
  receptionnisteId    String
  peutConsulterAgenda Boolean        @default(true)
  peutGererRdv        Boolean        @default(true)
  peutGererPlanning   Boolean        @default(false)
  peutGererParametres Boolean        @default(false)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  actif               Boolean        @default(true)
  professionnel       Professionnel  @relation(fields: [professionnelId], references: [id], onDelete: Cascade)
  receptionniste      Receptionniste @relation(fields: [receptionnisteId], references: [id], onDelete: Cascade)

  @@unique([professionnelId, receptionnisteId])
}

model Client {
  id            String       @id @default(uuid())
  nom           String
  prenom        String
  telephone     String       @unique
  email         String?
  dateNaissance DateTime?
  adresse       String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  NoteClient    NoteClient[]
  rendezVous    RendezVous[]

  @@index([nom, prenom])
}

enum StatutService {
  DISPONIBLE
  COMPLET
  INDISPONIBLE
}

model Service {
  id                  String              @id @default(uuid())
  professionnelId     String
  nom                 String
  description         String?
  dureeMinutes        Int
  prix                Int?
  actif               Boolean             @default(true)
  imageUrl            String?
  statut              StatutService       @default(DISPONIBLE)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  champsPersonnalises ChampPersonnalise[]
  rendezVous          RendezVous[]
  professionnel       Professionnel       @relation(fields: [professionnelId], references: [id], onDelete: Cascade)

  @@index([professionnelId])
}

model ChampPersonnalise {
  id                String         @id @default(uuid())
  professionnelId   String
  serviceId         String?
  label             String
  type              TypeChamp
  options           String[]       @default([])
  obligatoire       Boolean        @default(false)
  ordre             Int            @default(0)
  createdAt         DateTime       @default(now())
  conditionLogique  String         @default("ET")
  conditions        Json?
  requisSiCondition Boolean        @default(false)
  texteAide         String?
  valeurParDefaut   String?
  professionnel     Professionnel  @relation(fields: [professionnelId], references: [id], onDelete: Cascade)
  service           Service?       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  reponses          ReponseChamp[]
}

model ReponseChamp {
  id           String            @id @default(uuid())
  champId      String
  rendezVousId String
  valeur       String
  champ        ChampPersonnalise @relation(fields: [champId], references: [id], onDelete: Cascade)
  rendezVous   RendezVous        @relation(fields: [rendezVousId], references: [id], onDelete: Cascade)
}

model Disponibilite {
  id              String        @id @default(uuid())
  professionnelId String
  jourSemaine     Int
  heureDebut      String
  heureFin        String
  createdAt       DateTime      @default(now())
  professionnel   Professionnel @relation(fields: [professionnelId], references: [id], onDelete: Cascade)

  @@index([professionnelId, jourSemaine])
}

model Indisponibilite {
  id              String              @id @default(uuid())
  professionnelId String
  type            TypeIndisponibilite
  dateDebut       DateTime
  dateFin         DateTime
  motif           String?
  clientsNotifies Boolean             @default(false)
  createdAt       DateTime            @default(now())
  professionnel   Professionnel       @relation(fields: [professionnelId], references: [id], onDelete: Cascade)

  @@index([professionnelId, dateDebut, dateFin])
}

model RendezVous {
  id                String             @id @default(uuid())
  professionnelId   String
  serviceId         String
  clientId          String
  dateDebut         DateTime
  dateFin           DateTime
  statut            StatutRdv          @default(RESERVE)
  origine           OrigineRdv         @default(EN_LIGNE)
  remarque          String?
  motifAnnulation   String?
  manageToken       String?            @unique
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  changeUsed        Boolean            @default(false)
  nombreChangements Int                @default(0)
  historique        HistoriqueStatut[]
  client            Client             @relation(fields: [clientId], references: [id])
  professionnel     Professionnel      @relation(fields: [professionnelId], references: [id], onDelete: Cascade)
  service           Service            @relation(fields: [serviceId], references: [id])
  reponsesChamps    ReponseChamp[]

  @@unique([professionnelId, dateDebut])
  @@index([professionnelId, dateDebut, dateFin])
  @@index([clientId])
  @@index([statut])
}

model HistoriqueStatut {
  id            String     @id @default(uuid())
  rendezVousId  String
  ancienStatut  StatutRdv?
  nouveauStatut StatutRdv
  changedBy     String?
  createdAt     DateTime   @default(now())
  rendezVous    RendezVous @relation(fields: [rendezVousId], references: [id], onDelete: Cascade)
}

model Notification {
  id          String           @id @default(uuid())
  recipientId String
  senderId    String?
  type        TypeNotification
  message     String
  lu          Boolean          @default(false)
  createdAt   DateTime         @default(now())

  recipient User  @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  sender    User? @relation("NotificationSender", fields: [senderId], references: [id], onDelete: SetNull)

  @@index([recipientId, lu])
  @@index([senderId])
}

model AuditLog {
  id              String   @id @default(uuid())
  userId          String?
  action          String
  cible           String?
  details         Json?
  ipAddress       String?
  createdAt       DateTime @default(now())
  professionnelId String?
  user            User?    @relation(fields: [userId], references: [id])

  @@index([action])
  @@index([createdAt])
  @@index([professionnelId, createdAt])
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  code      String
  type      TypeToken @default(VERIFICATION_EMAIL)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model NoteClient {
  id              String        @id
  professionnelId String
  clientId        String
  texte           String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime
  Client          Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  Professionnel   Professionnel @relation(fields: [professionnelId], references: [id], onDelete: Cascade)

  @@index([professionnelId, clientId])
}

model ParametresReservation {
  id                     String        @id
  professionnelId        String        @unique
  intervalleMinutes      Int           @default(10)
  delaiMinHeures         Int           @default(2)
  delaiMaxJours          Int           @default(90)
  seuilAbsences          Int           @default(2)
  maxRdvParClientParJour Int           @default(1)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime
  Professionnel          Professionnel @relation(fields: [professionnelId], references: [id], onDelete: Cascade)
}

enum ModeSupervision {
  ADMIN
  PRESTATAIRE
}

enum Role {
  ADMIN
  PROFESSIONNEL
  RECEPTIONNISTE
}

enum StatutCompte {
  EN_ATTENTE
  ACTIF
  REFUSE
  DESACTIVE
}

enum TypeChamp {
  TEXTE
  NOMBRE
  SELECTION
  RADIO
  CHECKBOX
  DATE
  TEXTE_LONG
  SWITCH
  FICHIER
}

enum TypeIndisponibilite {
  CRENEAU
  JOURNEE
  PERIODE
}

enum StatutRdv {
  RESERVE
  CLIENT_ARRIVE
  EN_COURS
  TERMINE
  ABSENT
  ANNULE
}

enum OrigineRdv {
  EN_LIGNE
  RECEPTIONNISTE
  PROFESSIONNEL
}

enum TypeNotification {
  NOUVELLE_RESERVATION
  ANNULATION
  MODIFICATION
  CHANGEMENT_STATUT
  PROFESSIONNEL_ABSENT
  RAPPEL
  CONFLIT_PLANNING
  COMPTE_VALIDE
  COMPTE_REFUSE
  AFFECTATION
  AUTORISATIONS_MODIFIEES
}

enum TypeToken {
  VERIFICATION_EMAIL
  RESET_PASSWORD
}
