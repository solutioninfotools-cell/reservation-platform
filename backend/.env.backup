# ==== Base de données ====
# REMPLACEZ ces deux lignes par vos vraies chaînes de connexion.
# DATABASE_URL : connexion applicative (pooler si vous en utilisez un).
# DIRECT_URL   : même base, connexion directe (port non poolé), utilisée par Prisma
#                pour les migrations et `db push`.
DATABASE_URL="postgresql://utilisateur:motdepasse@hote:5432/rendezvousapp"
DIRECT_URL="postgresql://utilisateur:motdepasse@hote:5432/rendezvousapp"

# Exemple Supabase :
# DATABASE_URL="postgresql://postgres.xxxxxxxx:MOT_DE_PASSE@aws-0-eu-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.xxxxxxxx:MOT_DE_PASSE@aws-0-eu-west-2.pooler.supabase.com:5432/postgres"
#
# Exemple Postgres local via docker-compose.yml (docker compose up -d) :
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rendezvousapp"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/rendezvousapp"

# ==== Authentification ====
JWT_SECRET="yDcHkmOeqUKMp7aMkdbhWmswT2tjgxVENuzNpFt3JAiyAWtbGsACvUpTVtZdT-07"
JWT_EXPIRES_IN="8h"

# ==== Serveur ====
PORT=3000
# Origine autorisée pour le navigateur : c'est le port du serveur de dev Vite.
CORS_ORIGIN="http://localhost:5173"
