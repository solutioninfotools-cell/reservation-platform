# ==== Backend (NestJS) — à copier dans backend/.env ====

# Base de données Supabase.
# DATABASE_URL : connexion via le pooler (pgbouncer), utilisée par l'application.
# DIRECT_URL   : connexion directe, requise par `prisma migrate` / `prisma db push`.
DATABASE_URL="postgresql://postgres.xxxxxxxxxx:VOTRE_MOT_DE_PASSE@aws-0-eu-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxxxxxxx:VOTRE_MOT_DE_PASSE@aws-0-eu-west-2.pooler.supabase.com:5432/postgres"

# Secret de signature des JWT — OBLIGATOIRE, le serveur refuse de démarrer sans.
# Générez une valeur réellement aléatoire :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="remplacez-moi-par-une-valeur-longue-et-aleatoire"
JWT_EXPIRES_IN="8h"

PORT=3000

# Origines autorisées, séparées par des virgules.
# Doit correspondre au port du serveur Vite (frontend/vite.config.ts -> server.port).
CORS_ORIGIN="http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174"

# ==== Frontend (Vite) — à copier dans frontend/.env ====
VITE_API_URL="http://localhost:3000/api"
VITE_SOCKET_URL="http://localhost:3000/events"
